@startuml
title Diagrama UML de clases (Sistema de gestion de usuarios y Parque)


' ╔════════════════════════════════════════════════╗
' ║APP - PUNTO DE ENTRADA                          ║
' ╚════════════════════════════════════════════════╝

class App {
    + {static} main(String[] args)
}



' ╔════════════════════════════════════════════════╗
' ║GESTOR PARQUE                                   ║
' ╚════════════════════════════════════════════════╝

class GestorParque {
    - {static} instancia : GestorParque
    - fechaActual : LocalDate
    - precioActual : double

    - GestorParque()
    + {static} getInstancia() : GestorParque
    + getFechaActual() : LocalDate
    + setFechaActual(LocalDate fechaActual)
    + getPrecioActual() : double
    + setPrecioActual(double precioActual)
    + getGrupos() : TreeMap<String, Grupo>
    + buscarGrupo(String identificador) : Grupo
    + registrarGrupo(Grupo grupo)
    + eliminarGrupo(String identificador)
    + retirarUsuarioDeGrupos(Usuario usuario)
    + grupoTieneEntradasActivas(Grupo grupo) : boolean
    + desvincularGrupoDeEntradas(Grupo grupo)
    + usuarioPerteneceAGrupoBloqueado(Usuario usuario) : boolean
    + getEntradas() : TreeMap<String, Entrada>
    + buscarEntrada(String identificador) : Entrada
    + existeEntrada(String identificador) : boolean
    + registrarEntrada(Entrada entrada)
    + eliminarEntrada(String identificador)
    + usuarioTieneEntradasActivas(Usuario usuario) : boolean
}



' ╔════════════════════════════════════════════════╗
' ║LECTURA DE COMANDOS                             ║
' ╚════════════════════════════════════════════════╝

class LecturaComandos {
    + {static} iniciar(String[] args)
    + {static} finalizarPrograma()
    - {static} obtenerSiguienteComando()
}

note left of LecturaComandos
    Admite dos modos de entrada:
    - Interactivo
    - Fichero de comandos

    Delega la interpretacion
    en GestorComandos.
end note


' ╔════════════════════════════════════════════════╗
' ║GESTOR DE COMANDOS                              ║
' ╚════════════════════════════════════════════════╝

class GestorComandos {
     + {static} analizarComando(String linea)
     - {static} crearUsuario(String[] campos)
     - {static} eliminarUsuario(String[] campos)
     - {static} modificarUsuario(String[] campos)
     - {static} buscarUsuarioPorCorreo(String correo)
     - {static} modificarFechaSistema(String[] partes)
     - {static} modificarPrecioSistema(String[] partes)
     - {static} crearGrupo(String[] partes)
     - {static} agregarUsuarioGrupo(String[] partes)
     - {static} eliminarUsuarioGrupo(String[] partes)
     - {static} eliminarGrupo(String[] partes)
     - {static} crearEntradaIndividual(String[] partes)
     - {static} eliminarEntradaIndividual(String[] partes)
     - {static} crearEntradaGrupo(String[] partes)
     - {static} eliminarEntradaGrupo(String[] partes)
}



' ╔════════════════════════════════════════════════╗
' ║ENUMERADO DE COMANDOS                           ║
' ╚════════════════════════════════════════════════╝

enum ComandoApp {
    USER_CREATE
    USER_DELETE
    USER_UPDATE
    SYSTEM_DATE
    SYSTEM_PRICE
    GROUP_CREATE
    GROUP_ADD
    GROUP_REMOVE
    GROUP_DELETE
    TICKET_CREATE
    TICKET_DELETE
    GROUPTICKET_CREATE
    GROUPTICKET_DELETE
    ATTRACTION_CREATE
    ATTRACTION_ENTER
    ATTRACTION_EXIT
    ATTRACTION_LIST
    ATTRACTION_STATUS
    HELP

    + {static} obtenerComando(String textoComando) : ComandoApp
}



' ╔════════════════════════════════════════════════╗
' ║ENTRADAS - JERARQUIA DE HERENCIA                ║
' ╚════════════════════════════════════════════════╝

abstract class Entrada {
    - identificador : String {readOnly}
    - fecha : LocalDate {readOnly}
    - precioBase : double {readOnly}

    + Entrada(String identificador, LocalDate fecha, double precioBase)
    + getIdentificador() : String
    + getFecha() : LocalDate
    + getPrecioBase() : double
    # calcularPrecioConDescuento(double porcentajeDescuento) : double
    + getPrecio() : double
    + esActiva(LocalDate fechaSistema) : boolean
    + puedeEliminarse(LocalDate fechaSistema) : boolean
    + esValidaParaFecha(LocalDate fechaSistema) : boolean
    + esEntradaIndividual() : boolean
    + esEntradaGrupo() : boolean
    + esParteDeGrupo() : boolean
    + perteneceAGrupo(Grupo grupo) : boolean
    + desvincularGrupo(Grupo grupo)
    + getEntradasGestionadas() : List<Entrada>
    + {abstract} getUsuarios() : List<Usuario>
    + {abstract} contieneUsuario(Usuario usuario) : boolean
}

note right of Entrada::identificador
    Identificador unico comun
    para todos los tipos de entrada.
    Clave del TreeMap en GestorParque.
end note

class EntradaIndividual {
    - descuento : double {readOnly}
    - parteDeGrupo : boolean {readOnly}

    + EntradaIndividual(String identificador, LocalDate fecha, double precioBase, Usuario usuario)
    + EntradaIndividual(String identificador, LocalDate fecha, double precioBase, Usuario usuario, double descuento, boolean parteDeGrupo)
    + getUsuario() : Usuario
    + esEntradaIndividual() : boolean
    + esParteDeGrupo() : boolean
    + getPrecio() : double
    + getUsuarios() : List<Usuario>
    + contieneUsuario(Usuario usuarioBuscado) : boolean
}

class EntradaGrupo {
    + EntradaGrupo(String identificador, LocalDate fecha, double precioBase, Grupo grupo)
    + getGrupo() : Grupo
    + getEntradasIndividuales() : List<EntradaIndividual>
    + esEntradaGrupo() : boolean
    + perteneceAGrupo(Grupo grupoBuscado) : boolean
    + desvincularGrupo(Grupo grupoEliminado)
    + getEntradasGestionadas() : List<Entrada>
    + {static} calcularDescuento(int numMiembros) : double
    + getPrecio() : double
    + getUsuarios() : List<Usuario>
    + contieneUsuario(Usuario usuarioBuscado) : boolean
}

note right of EntradaGrupo
    Compuesta por entradas individuales
    con ID <idGrupoTicket>:<dni>.
    No duplica una coleccion de usuarios.
    La referencia al grupo puede pasar
    a null si el grupo se elimina.
end note



' ╔════════════════════════════════════════════════╗
' ║GRUPO - MODELO DE DATOS                         ║
' ╚════════════════════════════════════════════════╝

class Grupo {
    - identificador : String {readOnly}
    - nombre : String

    + Grupo(String identificador, String nombre)
    + getIdentificador() : String
    + getNombre() : String
    + setNombre(String nombre)
    + getMiembros() : TreeMap<String, Usuario>
    + agregarMiembro(Usuario usuario) : boolean
    + eliminarMiembro(String correo) : boolean
    + contieneMiembro(Usuario usuario) : boolean
}

note right of Grupo::identificador
    Identificador inmutable.
    Se utiliza como clave
    del TreeMap en GestorParque.
end note



' ╔════════════════════════════════════════════════╗
' ║USUARIO - MODELO DE DATOS                       ║
' ╚════════════════════════════════════════════════╝

class Usuario {
    - dni : String {readOnly}
    - nombre : String
    - apellidos : String
    - email : String
    - contrasena : String
    - telefono : String
    - numeroTarjeta : String

    + Usuario(...)

    {field} // getters y setters //
    + {static} validarDNI(String dni)
    + {static} validarCorreo(String correo)
    + {static} validarContraseña(String clave)
    + {static} validarTarjeta(String tarjeta)
}

note right of Usuario::dni
    Identificador inmutable.
    Se utiliza como clave
    del TreeMap en Persistencia.
end note


' ╔════════════════════════════════════════════════╗
' ║PERSISTENCIA                                    ║
' ╚════════════════════════════════════════════════╝

class Persistencia {
    ~ {static} rutaFicheroPersistencia : String
    ~ {static} ficheroPersistencia : Path

    + {static} inicializar()
    + {static} lecturaPersistencia()
    + {static} altaUsuarios(Usuario u)
    + {static} bajaUsuarios(Usuario u)
    + {static} modificarUsuario()
    + {static} escribirPersistencia()
    + {static} listarUsuariosTreeMap()
    + {static} listarUsuariosFichero()
}

note right of Persistencia::USUARIOS
    Almacenamiento en memoria (TreeMap).
    Clave: DNI
    Valor: objeto Usuario
end note


' ╔════════════════════════════════════════════════╗
' ║ENUMERADO DE CAMPOS                             ║
' ╚════════════════════════════════════════════════╝

enum CampoUsuario {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
}


' ╔════════════════════════════════════════════════╗
' ║HERENCIA                                        ║
' ╚════════════════════════════════════════════════╝

Entrada <|-- EntradaIndividual
Entrada <|-- EntradaGrupo


' ╔════════════════════════════════════════════════╗
' ║DEPENDENCIAS DE USO                             ║
' ╚════════════════════════════════════════════════╝

App ..> LecturaComandos : inicia >
App ..> Persistencia : inicializa >
App ..> GestorParque : inicializa >

LecturaComandos ..> GestorComandos : delega >

GestorComandos ..> ComandoApp : clasifica mediante >
GestorComandos ..> CampoUsuario : utiliza >
GestorComandos ..> Persistencia : solicita operaciones >
GestorComandos ..> Usuario : gestiona >
GestorComandos ..> GestorParque : actualiza estado >
GestorComandos ..> Grupo : gestiona >
GestorComandos ..> Entrada : gestiona >
GestorComandos ..> EntradaIndividual : crea >
GestorComandos ..> EntradaGrupo : crea >


' ╔════════════════════════════════════════════════╗
' ║ASOCIACIONES Y COMPOSICIONES                    ║
' ╚════════════════════════════════════════════════╝

Persistencia "1\n-almacen" --> "0..*\n-usuarios" Usuario : almacena >
GestorParque "1" *--> "0..*\n-grupos" Grupo : gestiona >
GestorParque "1" *--> "0..*\n-entradas" Entrada : gestiona >
Grupo "0..*" o--> "0..*\n-miembros" Usuario : agrupa >
EntradaIndividual "0..*" --> "1\n-usuario" Usuario : asociada a >
EntradaGrupo "0..1" *--> "1..*\n-entradasIndividuales" EntradaIndividual : compuesta por >
EntradaGrupo "0..*" --> "0..1\n-grupo" Grupo : asociada a >

@enduml